{
  "goal": "Summarize the supplied research note, its evaluation and limitations.",
  "sources": ["source.txt"],
  "criteria": [
    {"id": "method", "description": "Explain the proposed method.", "priority": 3},
    {"id": "evaluation", "description": "Describe how the method is evaluated.", "priority": 2},
    {"id": "limitations", "description": "Identify limitations and deferred work.", "priority": 1}
  ],
  "budget": {"max_usd": 0.1, "max_seconds": 120},
  "permissions": {
    "read_roots": ["."],
    "output_root": ".spawn",
    "allowed_models": ["fast", "alternative"],
    "send_documents": false
  },
  "allow_scope_reduction": true,
  "on_failure": "defer",
  "task_class": "research-note-summary",
  "control_file": "control.json"
}
